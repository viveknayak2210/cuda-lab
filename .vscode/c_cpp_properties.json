{
  "version": 4,
  "configurations": [
    {
      "name": "cuda-lab (offline, Apple Silicon)",
      "includePath": [
        "${workspaceFolder}/common",
        "${workspaceFolder}/.cuda-include"
      ],
      "forcedInclude": [
        "${workspaceFolder}/.cuda-include/cuda_runtime.h"
      ],
      "defines": [
        "__CUDACC__"
      ],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-arm64"
    }
  ]
}
